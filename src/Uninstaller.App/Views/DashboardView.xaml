<UserControl x:Class="Uninstaller.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
