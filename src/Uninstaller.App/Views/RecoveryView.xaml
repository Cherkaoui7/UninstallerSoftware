<UserControl x:Class="Uninstaller.App.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Uninstaller.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Recovery Preflight" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="{Binding ApplicationName, StringFormat='Application: {0}'}" FontSize="16" />
            <TextBlock Text="{Binding CleanupSessionId, StringFormat='Cleanup Session: {0}'}" FontSize="14" Foreground="Gray" />
        </StackPanel>

        <!-- Items List -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Select">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                      IsEnabled="{Binding IsRecoverable}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Type" Binding="{Binding ArtifactType}" IsReadOnly="True" />
                <DataGridTextColumn Header="Original Path" Binding="{Binding OriginalPath}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Backup Status" Binding="{Binding BackupVerificationStatus}" IsReadOnly="True" />
                <DataGridTextColumn Header="Failure / Conflict" Binding="{Binding ConflictStatus}" IsReadOnly="True" Foreground="Red" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="{Binding SelectedItemsCount, StringFormat='Selected Items: {0}'}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding UnrecoverableItemsCount, StringFormat='Unrecoverable Items (Cannot be selected): {0}'}" Foreground="Gray" />
                <TextBlock Text="Warning: The engine will revalidate every item before restoration." Foreground="#d97706" Margin="0,5,0,0" />
            </StackPanel>

            <Button Grid.Column="1" 
                    Content="Confirm Recovery" 
                    Command="{Binding ConfirmCommand}" 
                    Padding="20,10" 
                    Background="#2563eb" Foreground="White" FontWeight="Bold" />
        </Grid>
    </Grid>
</UserControl>
